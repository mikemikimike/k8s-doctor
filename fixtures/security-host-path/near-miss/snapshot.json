{
  "schemaVersion": "v1alpha1",
  "mode": "manifest",
  "source": {
    "path": "fixtures/security-host-path/near-miss"
  },
  "spec": {
    "namespaces": [
      {
        "name": "shop"
      }
    ],
    "workloads": [
      {
        "kind": "Deployment",
        "apiVersion": "apps/v1",
        "name": "web",
        "namespace": "shop",
        "template": {
          "labels": {
            "app": "web"
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true
            },
            "containers": [
              {
                "name": "web",
                "image": "ghcr.io/acme/web:1.0.0",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "handler": "httpGet",
                  "path": "/healthz",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true
                }
              }
            ],
            "volumes": [
              {
                "name": "host",
                "type": "emptyDir"
              },
              {
                "name": "config",
                "type": "configMap",
                "source": "web-config"
              },
              {
                "name": "tls",
                "type": "secret",
                "source": "web-tls"
              },
              {
                "name": "data",
                "type": "persistentVolumeClaim",
                "source": "web-data"
              }
            ]
          }
        },
        "replicas": 2,
        "selector": {
          "app": "web"
        }
      }
    ]
  }
}
