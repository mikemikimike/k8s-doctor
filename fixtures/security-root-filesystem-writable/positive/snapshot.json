{
  "schemaVersion": "v1alpha1",
  "mode": "manifest",
  "source": {
    "path": "fixtures/security-root-filesystem-writable/positive"
  },
  "spec": {
    "namespaces": [
      {
        "name": "shop"
      }
    ],
    "workloads": [
      {
        "kind": "Deployment",
        "apiVersion": "apps/v1",
        "name": "web",
        "namespace": "shop",
        "template": {
          "labels": {
            "app": "web"
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true
            },
            "containers": [
              {
                "name": "web",
                "image": "ghcr.io/acme/web:1.0.0",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "handler": "httpGet",
                  "path": "/healthz",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false
                }
              }
            ]
          }
        },
        "replicas": 2,
        "selector": {
          "app": "web"
        }
      },
      {
        "kind": "StatefulSet",
        "apiVersion": "apps/v1",
        "name": "db",
        "namespace": "shop",
        "template": {
          "labels": {
            "app": "db"
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true
            },
            "containers": [
              {
                "name": "db",
                "image": "ghcr.io/acme/db:1.0.0",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "handler": "httpGet",
                  "path": "/healthz",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": false
                }
              }
            ]
          }
        },
        "replicas": 1,
        "selector": {
          "app": "db"
        }
      },
      {
        "kind": "Job",
        "apiVersion": "batch/v1",
        "name": "migrate",
        "namespace": "shop",
        "template": {
          "labels": {
            "app": "migrate"
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true
            },
            "containers": [
              {
                "name": "migrate",
                "image": "ghcr.io/acme/migrate:1.0.0",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "handler": "httpGet",
                  "path": "/healthz",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                }
              }
            ]
          }
        },
        "selector": {
          "app": "migrate"
        }
      }
    ]
  }
}
