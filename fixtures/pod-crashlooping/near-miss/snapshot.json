{
  "schemaVersion": "v1alpha1",
  "mode": "cluster",
  "source": {
    "cluster": "kind-k8s-doctor"
  },
  "spec": {
    "namespaces": [
      {
        "name": "shop"
      }
    ],
    "workloads": [
      {
        "kind": "Deployment",
        "apiVersion": "apps/v1",
        "name": "api",
        "namespace": "shop",
        "template": {
          "labels": {
            "app": "api"
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true
            },
            "containers": [
              {
                "name": "api",
                "image": "ghcr.io/acme/api:1.0.0",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "handler": "httpGet",
                  "path": "/healthz",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true
                }
              }
            ],
            "topologySpreadConstraints": [
              {
                "topologyKey": "kubernetes.io/hostname",
                "maxSkew": 1,
                "whenUnsatisfiable": "ScheduleAnyway"
              }
            ]
          }
        },
        "replicas": 2,
        "selector": {
          "app": "api"
        }
      },
      {
        "kind": "Deployment",
        "apiVersion": "apps/v1",
        "name": "cache",
        "namespace": "shop",
        "template": {
          "labels": {
            "app": "cache"
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true
            },
            "containers": [
              {
                "name": "cache",
                "image": "ghcr.io/acme/cache:1.0.0",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "handler": "httpGet",
                  "path": "/healthz",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true
                }
              }
            ],
            "topologySpreadConstraints": [
              {
                "topologyKey": "kubernetes.io/hostname",
                "maxSkew": 1,
                "whenUnsatisfiable": "ScheduleAnyway"
              }
            ]
          }
        },
        "replicas": 2,
        "selector": {
          "app": "cache"
        }
      },
      {
        "kind": "Job",
        "apiVersion": "batch/v1",
        "name": "migrate",
        "namespace": "shop",
        "template": {
          "labels": {
            "app": "migrate"
          },
          "spec": {
            "securityContext": {
              "runAsNonRoot": true
            },
            "containers": [
              {
                "name": "migrate",
                "image": "ghcr.io/acme/migrate:1.0.0",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "memory": "256Mi"
                  }
                },
                "readinessProbe": {
                  "handler": "httpGet",
                  "path": "/healthz",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "livenessProbe": {
                  "handler": "httpGet",
                  "path": "/livez",
                  "port": "8080",
                  "periodSeconds": 10
                },
                "securityContext": {
                  "runAsNonRoot": true,
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true
                }
              }
            ]
          }
        },
        "selector": {
          "app": "migrate"
        }
      }
    ],
    "podDisruptionBudgets": [
      {
        "apiVersion": "policy/v1",
        "name": "api",
        "namespace": "shop",
        "selector": {
          "app": "api"
        },
        "maxUnavailable": "1"
      },
      {
        "apiVersion": "policy/v1",
        "name": "cache",
        "namespace": "shop",
        "selector": {
          "app": "cache"
        },
        "maxUnavailable": "1"
      }
    ]
  },
  "runtime": {
    "pods": [
      {
        "name": "api-7d9f-a",
        "namespace": "shop",
        "phase": "Running",
        "nodeName": "worker-1",
        "containers": [
          {
            "name": "api",
            "ready": true,
            "restartCount": 4,
            "state": "running",
            "lastTermination": {
              "reason": "Error",
              "exitCode": 1,
              "finishedAt": "2026-11-20T09:00:00Z"
            }
          }
        ],
        "owner": {
          "kind": "Deployment",
          "namespace": "shop",
          "name": "api"
        }
      },
      {
        "name": "api-7d9f-b",
        "namespace": "shop",
        "phase": "Running",
        "nodeName": "worker-1",
        "containers": [
          {
            "name": "api",
            "ready": false,
            "restartCount": 0,
            "state": "waiting",
            "reason": "ImagePullBackOff"
          }
        ],
        "owner": {
          "kind": "Deployment",
          "namespace": "shop",
          "name": "api"
        }
      },
      {
        "name": "cache-4b2c-a",
        "namespace": "shop",
        "phase": "Running",
        "nodeName": "worker-1",
        "containers": [
          {
            "name": "cache",
            "ready": true,
            "restartCount": 12,
            "state": "running",
            "lastTermination": {
              "reason": "Error",
              "exitCode": 1,
              "finishedAt": "2026-11-20T09:00:00Z"
            }
          }
        ],
        "owner": {
          "kind": "Deployment",
          "namespace": "shop",
          "name": "cache"
        }
      },
      {
        "name": "migrate-x1",
        "namespace": "shop",
        "phase": "Succeeded",
        "nodeName": "worker-1",
        "containers": [
          {
            "name": "migrate",
            "ready": false,
            "restartCount": 0,
            "state": "terminated",
            "reason": "Completed"
          }
        ],
        "owner": {
          "kind": "Job",
          "namespace": "shop",
          "name": "migrate"
        }
      }
    ]
  }
}
